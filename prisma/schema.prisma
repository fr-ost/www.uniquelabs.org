// =============================================================================
// Unique Labs — database schema (PostgreSQL)
//
// Conventions
// - Primary content entities carry: id, slug, createdAt, updatedAt, status
//   (publication state) and sortOrder where ordering matters.
// - Import candidates live in their own tables and never appear publicly.
//   Approving a candidate creates a DRAFT content record; publishing is a
//   separate, explicit step.
// - Products, collaborations and milestones can only be PUBLISHED once an
//   owner has verified them (verifiedAt). This is enforced in application
//   code AND by CHECK constraints in the initial migration.
// - isPlaceholder marks development sample content. Public queries exclude it
//   in production builds.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DatePrecision {
  DAY
  MONTH
  YEAR
}

/// Lifecycle stage of a product, shown publicly as a status badge.
enum ReleaseStage {
  AVAILABLE // "Published" — live and usable
  BETA
  COMING_SOON
  DISCONTINUED // "Archived" — no longer maintained
}

enum Platform {
  CHROME_EXTENSION
  FIREFOX_ADDON
  EDGE_ADDON
  SAFARI_EXTENSION
  WEB_APP
  WEBSITE
  IOS
  ANDROID
  MACOS
  WINDOWS
  LINUX
  CLI
  API
  OTHER
}

enum PricingModel {
  UNSPECIFIED
  FREE
  FREEMIUM
  PAID
  OPEN_SOURCE
}

enum LinkKind {
  WEBSITE
  STORE_LISTING
  SOURCE_CODE
  DOCUMENTATION
  SUPPORT
  PRIVACY_POLICY
  CHANGELOG
  SOCIAL
  OTHER
}

enum CollaborationCategory {
  BRAND_PARTNERSHIP
  PRODUCT_INTEGRATION
  CO_CREATION
  SPONSORSHIP
  CAMPAIGN
  COMMUNITY
  CONTRIBUTION
  OTHER
}

enum TeamMemberType {
  CURRENT
  FORMER
}

enum MilestoneKind {
  FOUNDING
  PRODUCT
  LAUNCH
  COLLABORATION
  MILESTONE
  PLATFORM
  ORGANIZATION
  OTHER
}

enum SocialPlatform {
  X
  LINKEDIN
  GITHUB
  YOUTUBE
  INSTAGRAM
  FACEBOOK
  THREADS
  BLUESKY
  MASTODON
  DISCORD
  TELEGRAM
  MEDIUM
  PRODUCT_HUNT
  CHROME_WEB_STORE
  OTHER
}

enum InquiryType {
  GENERAL
  BUSINESS
  PARTNERSHIP
  PRESS
  SUPPORT
  OTHER
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
  SPAM
}

enum AdminRole {
  OWNER
  EDITOR
}

enum MediaStorage {
  DATABASE
  FILESYSTEM
}

enum ImportKind {
  CLAUDE_EXPORT
  X_ARCHIVE
}

enum ImportStatus {
  AWAITING_FILES
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum CandidateKind {
  PRODUCT
  COLLABORATION
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
  MERGED
}

/// Evidence-based development stage detected for a product candidate.
enum ProductEvidenceStage {
  IDEA
  PLANNING
  IN_DEVELOPMENT
  COMPLETED
  BETA
  PUBLISHED
  CANCELLED
  NEEDS_VERIFICATION
}

enum VerificationStatus {
  NEEDS_VERIFICATION
  EVIDENCE_FOUND
  VERIFIED
}

enum EvidenceSource {
  CLAUDE_CONVERSATION
  CLAUDE_PROJECT
  CLAUDE_MEMORY
  TWEET
  URL
  MANUAL
}

// -----------------------------------------------------------------------------
// Singletons: company profile & site settings
// -----------------------------------------------------------------------------

model CompanyProfile {
  id Int @id @default(1)

  name             String  @default("Unique Labs")
  legalName        String?
  tagline          String?
  shortDescription String

  // Homepage hero + intro
  heroEyebrow       String?
  heroHeadline      String
  heroDescription   String
  primaryCtaLabel   String  @default("Explore Our Products")
  secondaryCtaLabel String  @default("Discover Unique Labs")
  introHeading      String?
  introBody         String?

  // About page (markdown)
  whoWeAre          String?
  whyWeExist        String?
  mission           String?
  vision            String?
  philosophyIntro   String?
  approach          String?
  longTermDirection String?

  // What We Do page intro (markdown)
  whatWeDoIntro String?

  // Closing call to action
  closingHeadline String?
  closingBody     String?

  // Verified facts only — every field is optional and hidden until set.
  foundedDate          DateTime?     @db.Date
  foundedDatePrecision DatePrecision @default(YEAR)
  foundedDateVerified  Boolean       @default(false)

  // Contact information (all optional; hidden until configured)
  contactIntro     String?
  contactEmail     String?
  businessEmail    String?
  partnershipEmail String?
  generalEmail     String?
  pressEmail       String?
  country          String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  region           String?
  postalCode       String?
  showAddress      Boolean @default(false)

  logoId String?
  logo   MediaAsset? @relation("CompanyLogo", fields: [logoId], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id Int @id @default(1)

  seoTitleDefault  String   @default("Unique Labs")
  seoTitleTemplate String   @default("%s — Unique Labs")
  seoDescription   String
  seoKeywords      String[] @default([])
  twitterHandle    String?
  allowIndexing    Boolean  @default(true)

  googleSiteVerification String?
  bingSiteVerification   String?

  ogImageId String?
  ogImage   MediaAsset? @relation("SiteOgImage", fields: [ogImageId], references: [id], onDelete: SetNull)

  privacyPolicy    String
  privacyUpdatedAt DateTime? @db.Date
  termsOfUse       String
  termsUpdatedAt   DateTime? @db.Date

  contactFormEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// Products
// -----------------------------------------------------------------------------

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  tagline     String?
  summary     String
  description String?
  audience    String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  platforms Platform[]
  stage     ReleaseStage @default(COMING_SOON)
  pricing   PricingModel @default(UNSPECIFIED)

  websiteUrl      String?
  primaryCtaUrl   String?
  primaryCtaLabel String?

  releaseDate          DateTime?     @db.Date
  releaseDatePrecision DatePrecision @default(DAY)
  releaseDateVerified  Boolean       @default(false)

  accentColor String?

  logoId  String?
  logo    MediaAsset? @relation("ProductLogo", fields: [logoId], references: [id], onDelete: SetNull)
  coverId String?
  cover   MediaAsset? @relation("ProductCover", fields: [coverId], references: [id], onDelete: SetNull)

  seoTitle       String?
  seoDescription String?

  status        PublishStatus @default(DRAFT)
  featured      Boolean       @default(false)
  sortOrder     Int           @default(0)
  verifiedAt    DateTime?
  publishedAt   DateTime?
  isPlaceholder Boolean       @default(false)

  features       ProductFeature[]
  images         ProductImage[]
  links          ProductLink[]
  evidence       SourceEvidence[]
  milestones     CompanyMilestone[]
  capabilities   Capability[]
  collaborations Collaboration[]
  candidates     ImportCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
  @@index([categoryId])
}

model ProductFeature {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title       String
  description String?
  sortOrder   Int     @default(0)

  @@index([productId, sortOrder])
}

model ProductImage {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  caption   String?
  sortOrder Int        @default(0)

  @@index([productId, sortOrder])
}

model ProductLink {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      LinkKind @default(WEBSITE)
  label     String
  url       String
  sortOrder Int      @default(0)

  @@index([productId, sortOrder])
}

// -----------------------------------------------------------------------------
// Collaborations
// -----------------------------------------------------------------------------

model Partner {
  id             String                 @id @default(cuid())
  slug           String                 @unique
  name           String
  description    String?
  websiteUrl     String?
  xHandle        String?
  logoId         String?
  logo           MediaAsset?            @relation("PartnerLogo", fields: [logoId], references: [id], onDelete: SetNull)
  collaborations CollaborationPartner[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model Collaboration {
  id            String                @id @default(cuid())
  slug          String                @unique
  title         String
  summary       String
  description   String?
  category      CollaborationCategory @default(OTHER)
  date          DateTime?             @db.Date
  datePrecision DatePrecision         @default(DAY)

  sourceUrl   String?
  sourceLabel String?
  externalUrl String?

  coverId String?
  cover   MediaAsset? @relation("CollaborationCover", fields: [coverId], references: [id], onDelete: SetNull)

  status        PublishStatus @default(DRAFT)
  featured      Boolean       @default(false)
  sortOrder     Int           @default(0)
  verifiedAt    DateTime?
  publishedAt   DateTime?
  isPlaceholder Boolean       @default(false)

  partners   CollaborationPartner[]
  products   Product[]
  evidence   SourceEvidence[]
  milestones CompanyMilestone[]
  candidates ImportCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, date])
}

model CollaborationPartner {
  collaborationId String
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  partnerId       String
  partner         Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  role            String?
  sortOrder       Int           @default(0)

  @@id([collaborationId, partnerId])
  @@index([partnerId])
}

// -----------------------------------------------------------------------------
// Team
// -----------------------------------------------------------------------------

model TeamGroup {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  sortOrder   Int          @default(0)
  members     TeamMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TeamMember {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  position         String
  shortBio         String?
  bio              String?
  responsibilities String[] @default([])
  expertise        String[] @default([])

  photoId String?
  photo   MediaAsset? @relation("TeamPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  linkedinUrl String?
  xUrl        String?
  githubUrl   String?
  websiteUrl  String?

  joinDate          DateTime?     @db.Date
  joinDatePrecision DatePrecision @default(MONTH)
  joinDateVerified  Boolean       @default(false)

  memberType     TeamMemberType @default(CURRENT)
  isLeadership   Boolean        @default(false)
  hasProfilePage Boolean        @default(true)

  groupId String?
  group   TeamGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  status        PublishStatus @default(DRAFT)
  sortOrder     Int           @default(0)
  publishedAt   DateTime?
  isPlaceholder Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}

// -----------------------------------------------------------------------------
// Journey / timeline
// -----------------------------------------------------------------------------

model CompanyMilestone {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  description   String?
  date          DateTime      @db.Date
  datePrecision DatePrecision @default(DAY)
  kind          MilestoneKind @default(MILESTONE)

  imageId String?
  image   MediaAsset? @relation("MilestoneImage", fields: [imageId], references: [id], onDelete: SetNull)

  productId       String?
  product         Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  collaborationId String?
  collaboration   Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)

  sourceUrl   String?
  sourceLabel String?

  status        PublishStatus @default(DRAFT)
  featured      Boolean       @default(false)
  verifiedAt    DateTime?
  publishedAt   DateTime?
  isPlaceholder Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, date])
}

// -----------------------------------------------------------------------------
// What we do / philosophy / social
// -----------------------------------------------------------------------------

model Capability {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  summary       String
  description   String?
  icon          String        @default("sparkles")
  status        PublishStatus @default(DRAFT)
  featured      Boolean       @default(false)
  sortOrder     Int           @default(0)
  isPlaceholder Boolean       @default(false)
  products      Product[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Principle {
  id          String        @id @default(cuid())
  title       String
  description String
  status      PublishStatus @default(PUBLISHED)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model SocialLink {
  id        String         @id @default(cuid())
  platform  SocialPlatform
  label     String?
  url       String
  visible   Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// -----------------------------------------------------------------------------
// Contact
// -----------------------------------------------------------------------------

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  inquiryType InquiryType   @default(GENERAL)
  subject     String
  message     String
  status      MessageStatus @default(NEW)
  readAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
}

// -----------------------------------------------------------------------------
// Media
// -----------------------------------------------------------------------------

model MediaAsset {
  id         String       @id @default(cuid())
  fileName   String
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  alt        String       @default("")
  sha256     String       @unique
  storage    MediaStorage @default(DATABASE)
  storageKey String?
  blob       MediaBlob?

  uploadedById String?
  uploadedBy   AdminUser? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  companyLogos       CompanyProfile[]   @relation("CompanyLogo")
  siteOgImages       SiteSettings[]     @relation("SiteOgImage")
  productLogos       Product[]          @relation("ProductLogo")
  productCovers      Product[]          @relation("ProductCover")
  productImages      ProductImage[]
  partnerLogos       Partner[]          @relation("PartnerLogo")
  collaborationCover Collaboration[]    @relation("CollaborationCover")
  teamPhotos         TeamMember[]       @relation("TeamPhoto")
  milestoneImages    CompanyMilestone[] @relation("MilestoneImage")

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model MediaBlob {
  assetId String     @id
  asset   MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  data    Bytes
}

// -----------------------------------------------------------------------------
// Administration & security
// -----------------------------------------------------------------------------

model AdminUser {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String
  passwordHash      String
  role              AdminRole      @default(EDITOR)
  isActive          Boolean        @default(true)
  failedLoginCount  Int            @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime       @default(now())
  sessions          AdminSession[]
  auditLogs         AuditLog[]
  uploads           MediaAsset[]
  importJobs        ImportJob[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model AdminSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipHash     String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String
  action     String
  entityType String?
  entityId   String?
  summary    String
  metadata   Json?
  ipHash     String?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([action])
}

/// Fixed-window counters used for login and contact-form rate limiting.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// -----------------------------------------------------------------------------
// Import engine (private — never rendered publicly)
// -----------------------------------------------------------------------------

model ImportJob {
  id     String       @id @default(cuid())
  kind   ImportKind
  status ImportStatus @default(AWAITING_FILES)
  label  String?
  dryRun Boolean      @default(false)

  /// [{ name, size, sha256 }]
  files       Json    @default("[]")
  fingerprint String?

  phase          String?
  progress       Int     @default(0)
  processedItems Int     @default(0)
  totalItems     Int?

  stats        Json?
  warnings     Json?
  preview      Json?
  errorMessage String?

  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  candidates ImportCandidate[] @relation("CandidateFirstJob")
  evidence   SourceEvidence[]

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  heartbeatAt DateTime?

  @@index([kind, createdAt])
  @@index([fingerprint])
}

model ImportCandidate {
  id          String          @id @default(cuid())
  kind        CandidateKind
  status      CandidateStatus @default(PENDING)
  fingerprint String
  title       String
  summary     String?

  productStage          ProductEvidenceStage?
  collaborationCategory CollaborationCategory?
  confidence            Int                    @default(0)
  verification          VerificationStatus     @default(NEEDS_VERIFICATION)

  /// Extracted structured fields (urls, platforms, partners, hashtags, dates…)
  data    Json @default("{}")
  /// Human-readable reasons behind the classification
  signals Json @default("[]")

  firstSeenAt DateTime?
  lastSeenAt  DateTime?

  jobId String?
  job   ImportJob? @relation("CandidateFirstJob", fields: [jobId], references: [id], onDelete: SetNull)

  productId       String?
  product         Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  collaborationId String?
  collaboration   Collaboration? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)

  mergedIntoId String?
  mergedInto   ImportCandidate?  @relation("CandidateMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   ImportCandidate[] @relation("CandidateMerge")

  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?

  evidence SourceEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, fingerprint])
  @@index([kind, status, confidence])
}

model SourceEvidence {
  id              String         @id @default(cuid())
  sourceType      EvidenceSource
  sourceId        String
  sourceTitle     String?
  sourceUrl       String?
  excerpt         String?
  sourceTimestamp DateTime?
  author          String?
  /// Extracted details for this single source (urls, mentions, matched phrases)
  details         Json?
  /// Only ever true for evidence the owner explicitly made public (e.g. a tweet URL)
  isPublic        Boolean        @default(false)

  candidateId     String?
  candidate       ImportCandidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  collaborationId String?
  collaboration   Collaboration?   @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  jobId           String?
  job             ImportJob?       @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([candidateId, sourceType, sourceId])
  @@index([sourceType, sourceId])
  @@index([productId])
  @@index([collaborationId])
}
