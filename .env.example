# =========================================================================
#  AI Comment Generator for X - License Backend environment
#  Copy these into Railway > your service > Variables. Restart after changes.
# =========================================================================

# ---- Database (required) ----
# Add a Postgres plugin in Railway; it provides DATABASE_URL automatically.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ---- OpenAI (required for generation) ----
# Your OpenAI secret key. The ONLY place it lives. The extension never sees it.
OPENAI_API_KEY=sk-...

# ---- Admin dashboard (strongly recommended) ----
# Protects the dashboard at "/" and every /api/v1/admin/* + /api/v1/stats call.
# Use a long random string. This is also how you create/revoke keys.
DASHBOARD_KEY=change-me-to-a-long-random-string

# ---- Model lock ----
# The AI model, locked server-side. EVERY generation uses this no matter what.
# Users (and even per-key settings) cannot override it. Keep it cheap.
FORCE_MODEL=gpt-4.1-nano

# ---- New-key defaults (used when you create a key without specifying these) ----
NEW_KEY_DAILY_LIMIT=50
NEW_KEY_DEVICE_LIMIT=1

# ---- Optional ----
# Hard cap on output tokens per generation. Default 200.
MAX_OUTPUT_TOKENS=200
# Optional deterrent key for the telemetry endpoint (match in the extension).
INGEST_KEY=

# PORT is provided by Railway automatically.
# PORT=3000
