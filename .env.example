# =============================================================================
# Unique Labs website — environment variables
#
# Nothing is required: the site is static and works with no configuration.
# Content lives in src/content (see docs/CONTENT.md).
# =============================================================================

# Public URL of the site, no trailing slash. Used for canonical links, the
# sitemap and social share images. Defaults to https://www.uniquelabs.org.
# SITE_URL="http://localhost:3000"

# Opt out of Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
