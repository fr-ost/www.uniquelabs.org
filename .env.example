# =============================================================================
# Unique Labs website — environment variables
# Copy to `.env` for local development. In production, set these in your
# hosting provider's dashboard (never commit real secrets).
# =============================================================================

# --- Required ----------------------------------------------------------------

# PostgreSQL connection string. Locally: `docker compose up -d db`.
DATABASE_URL="postgresql://uniquelabs:uniquelabs@localhost:5432/uniquelabs?schema=public"

# Canonical public URL, no trailing slash. Used for canonical links, sitemap,
# Open Graph URLs, secure cookies and the apex→www redirect.
SITE_URL="http://localhost:3000"
# Production: SITE_URL="https://www.uniquelabs.org"

# Secret used to sign form tokens and hash IP addresses (rate limiting).
# REQUIRED in production: at least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=""

# --- First admin account (choose one method; see docs/ADMIN.md) ---------------

# Enables the one-time /admin/setup page while no admin exists. 24+ random
# characters. Remove it after creating the first account.
# Alternatively run `npm run admin:create` on the server and leave this empty.
ADMIN_SETUP_TOKEN=""

# --- Security & sessions (optional) ------------------------------------------

# Admin session lifetime (hours) and idle timeout (minutes).
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Number of reverse proxies in front of the app that append to
# X-Forwarded-For (Railway/Render/Fly/nginx: 1; direct exposure: 0).
TRUSTED_PROXY_COUNT=1

# Redirect the apex/www twin of SITE_URL to SITE_URL (production only).
# CANONICAL_REDIRECT=false

# --- Media library (optional) ------------------------------------------------

# "database" (default) stores images in PostgreSQL — works on any host and is
# included in database backups. "filesystem" stores them in MEDIA_DIR, which
# must be a persistent volume.
MEDIA_STORAGE="database"
MEDIA_DIR="./storage/media"
MEDIA_MAX_UPLOAD_MB=10

# --- Imports (optional) ------------------------------------------------------

# Private temporary directory for uploaded archives (deleted after processing).
# Defaults to the OS temp directory.
# IMPORT_TMP_DIR="/tmp/uniquelabs-imports"
# Maximum size per uploaded import file, in MB.
IMPORT_MAX_UPLOAD_MB=2048

# --- Database connection pool (optional) ------------------------------------
# DATABASE_POOL_SIZE=10

# --- Development only ---------------------------------------------------------

# Show development sample content in a local production build. Ignored unless
# SITE_URL points at localhost; never set this in production.
# ALLOW_PLACEHOLDER_CONTENT=false

# Disable the public data cache (debugging only).
# DISABLE_DATA_CACHE=false

# Separate database for the integration tests (must contain "test").
# TEST_DATABASE_URL="postgresql://uniquelabs:uniquelabs@localhost:5432/uniquelabs_test?schema=public"

# Opt out of Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
